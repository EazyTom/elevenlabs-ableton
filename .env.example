# Path to Ableton Live's Extension Host module. Overrides auto-discovery.
# EXTENSION_HOST_PATH=C:\ProgramData\Ableton\Live 12 Beta\Program\ExtensionHost\ExtensionHostNodeModule.node

# Pick a Live major version for npm start: 12, 13, or a full path.
# ABLETON_LIVE=12

# Folder containing api-key.txt (and persisted elevenlabs-config.json).
# ELEVENLABS_STORAGE_DIRECTORY=D:\Repos\ElevenLabs

# Temp folder for generated audio before importIntoProject.
# ELEVENLABS_TEMP_DIRECTORY=D:\Repos\ElevenLabs\.elevenlabs-temp
