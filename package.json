{
  "name": "elevenlabs-ableton",
  "version": "0.7.0",
  "license": "GPL-3.0-or-later",
  "main": "dist/extension.js",
  "engines": {
    "node": ">=24.16.0"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && tsx build.ts --production",
    "build:dev": "tsc --noEmit && tsx build.ts",
    "start": "npm run build:dev && tsx scripts/start-dev.ts",
    "package": "npm run build && extensions-cli package",
    "check:build": "tsx scripts/post-build-check.ts --skip-api",
    "check:api": "tsx scripts/post-build-check.ts",
    "check:api:full": "tsx scripts/post-build-check.ts --full",
    "postbuild": "npm run check:build",
    "publish": "tsx scripts/publish-release.ts"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:./vendor/ableton-extensions-sdk-1.0.0-beta.0.tgz",
    "@elevenlabs/elevenlabs-js": "^2.60.0",
    "fflate": "^0.8.3",
    "formdata-polyfill": "^4.0.10"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:./vendor/ableton-extensions-cli-1.0.0-beta.0.tgz",
    "@types/node": "^24.13.3",
    "esbuild": "0.28.1",
    "tsx": "^4.23.4",
    "typescript": "^7.0.2",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true
  }
}
